<!DOCTYPE html>
<html>
<head>
  <title>Thêm User</title>
</head>
<body>
  <h1>Thêm User mới</h1>
  <form action="/users/add" method="POST">
    <label>Tên:</label>
    <input type="text" name="name" required><br><br>
    <label>Email:</label>
    <input type="email" name="email" required><br><br>
    <button type="submit">Lưu</button>
  </form>
</body>
</html>
