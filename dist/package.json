{
  "name": "node-express-mvc",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
  "clean": "rimraf dist",
  "obf": "javascript-obfuscator src --output dist --config obfuscator-config.json",
  "copy:public": "cpx \"public/**\" dist/public",
  "copy:views": "cpx \"src/views/**\" dist/views || true",
  "copy:root": "cpx package.json dist",
  "build": "npm run clean && npm run obf && npm run copy:public && npm run copy:views && npm run copy:root",
  "start": "node app.js",
  "start:dist": "node dist/app.js",
  "prestart": "npm run build"
}
,
  "dependencies": {
    "ejs": "^3.1.9",
    "express": "^4.19.2",
    "mysql2": "^3.9.0"
  },
  "devDependencies": {
    "cpx": "^1.5.0",
    "javascript-obfuscator": "^4.1.1",
    "nodemon": "^3.1.0",
    "rimraf": "^6.0.1"
  }
}
